[Unit]
Description=MBU Django application (Gunicorn)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/mbu/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/mbu/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 backend.wsgi:application
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
