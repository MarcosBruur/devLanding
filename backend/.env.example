DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave DB_NAME unset to run without a database. If set, install mysqlclient.
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Email del formulario de contacto. Configurá un servidor SMTP antes de habilitar el envío.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Para puerto 587 usá TLS; para puerto 465, SSL. Si omitís ambos, se seleccionan según el puerto.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Dirección remitente autorizada por tu proveedor SMTP (p. ej., tu cuenta SMTP).
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL_TO=marcosbruur@gmail.com
